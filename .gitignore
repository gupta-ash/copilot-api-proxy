# Package builds use disposable independent clones; installed state is never source.

*.log
.DS_Store
.env
.env.*
*.env

# Standalone-bin scripts runtime state (start_proxy / stop_proxy / status_proxy).
# *.log already covers copilot-proxy.{stdout,stderr}.log; PID + meta sidecar
# + iter-3 start lock dir are listed explicitly so they don't leak into the repo.
logs/copilot-proxy.pid
logs/copilot-proxy.pid.tmp
logs/copilot-proxy.meta.json
logs/copilot-proxy.meta.json.tmp
logs/copilot-proxy.start.lock/
logs/copilot-proxy.start.lock

# Bun
bun.lockb

# Trace output (default location for `debug: raw`)
traces/

# F3: build-time generated by scripts/gen_version.ts
src/lib/transform/version.ts

# M3/X13: build-time generated by scripts/gen_barrel.ts
src/lib/transform/index.ts
